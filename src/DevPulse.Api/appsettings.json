{
  "ConnectionStrings": {
    "Default": ""
  },
  "Serilog": {
    "Using": [
      "Serilog.Sinks.Console"
    ],
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft.AspNetCore": "Warning",
        "Microsoft.EntityFrameworkCore": "Warning"
      }
    },
    "WriteTo": [
      {
        "Name": "Console"
      }
    ]
  },
  "Repositories": {
    "MaxPerUser": 50
  },
  "Snapshot": {
    "RefreshInterval": "00:15:00",
    "StaleAfter": "01:00:00",
    "ActiveUserWindow": "14.00:00:00"
  },
  "Auth": {
    "SessionLifetime": "14.00:00:00",
    "GitHub": {
      "ClientId": "",
      "ClientSecret": ""
    }
  },
  "DataProtection": {
    "RequireCertificate": true
  },
  "Admin": {
    "Logins": []
  },
  "RateLimiting": {
    "DefaultPerMinute": 120,
    "GitHubReadPerMinute": 20,
    "GitHubRefreshPerMinute": 2,
    "RepoMutationsPerMinute": 30,
    "EmailPerHour": 3,
    "EmailPerDay": 10,
    "AnonymousPerMinute": 10,
    "SensitivePerHour": 3
  },
  "Anthropic": {
    "Model": "claude-sonnet-5-5",
    "MaxTokens": 400,
    "Effort": "low",
    "Timeout": "00:00:20"
  },
  "SendGrid": {
    "FromEmail": "",
    "FromName": "DevPulse",
    "SandboxMode": false
  },
  "AllowedHosts": "*"
}
